# ---- Lumina Studio environment ----

# MongoDB connection string (MongoDB Atlas or local mongod)
MONGODB_URI="mongodb://127.0.0.1:27017"
MONGODB_DB="lumina_studio"

# Secret used to sign auth JWTs — set a long random string in production
JWT_SECRET="change-me-to-a-long-random-secret"

# Leonardo.ai API key (optional).
# If left blank, the app runs in MOCK mode so the panel is fully demo-able:
# images use placeholder photos and videos use sample clips, all clearly
# labelled "Demo". Add a real key to generate with Leonardo.
LEONARDO_API_KEY=""

# ---- Super Admin (panel at /admin) ----
# Seeds the default super admin on first login. Set strong values on the server.
# If omitted, defaults are used (admin@aivideocreat.live / admin12345).
ADMIN_EMAIL="admin@aivideocreat.live"
ADMIN_PASSWORD="change-this-strong-password"

# ---- Razorpay (optional here; preferably add from the admin panel) ----
# The admin → API Keys page stores these in the DB and overrides env.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
